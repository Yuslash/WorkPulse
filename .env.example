# =============================================================================
# WorkPulse Environment Configuration
# =============================================================================
# Copy this file to .env and configure the variables for your environment.
# Note: Never commit the actual .env file containing secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB)
# -----------------------------------------------------------------------------
# MongoDB connection URI (Atlas connection string or local mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017/workpulse

# Primary database name for production / development
MONGODB_DB=workpulse

# Dedicated isolated database name used exclusively by automated tests
MONGODB_TEST_DB=workpulse_test

# -----------------------------------------------------------------------------
# API Server Configuration (Fastify)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting toggle ('true' or 'false')
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Authentication & Cryptographic Secrets
# -----------------------------------------------------------------------------
# Generate high-entropy secrets with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-at-least-32-chars-long

# Token lifetimes (e.g., 15m, 1h, 7d, 30d)
ADMIN_ACCESS_TTL=15m
ADMIN_REFRESH_TTL=7d
AGENT_ACCESS_TTL=15m
AGENT_REFRESH_TTL=30d

# -----------------------------------------------------------------------------
# Presence & Telemetry Engine
# -----------------------------------------------------------------------------
# Time in seconds without heartbeats before a device is marked offline
PRESENCE_OFFLINE_AFTER_SEC=90

# Periodic interval in seconds for sweeping stale presence sessions
PRESENCE_SWEEP_INTERVAL_SEC=15

# Background aggregation and rollup intervals in seconds
ROLLUP_INTERVAL_SEC=60
RETENTION_INTERVAL_SEC=3600

# -----------------------------------------------------------------------------
# Initial Database Seed (Development Only)
# -----------------------------------------------------------------------------
SEED_ORG_NAME=Acme Corporation
SEED_ADMIN_EMAIL=admin@acme.test
SEED_ADMIN_PASSWORD=Admin123!pass

# -----------------------------------------------------------------------------
# Admin Dashboard Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
