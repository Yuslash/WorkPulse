# ---------------------------------------------------------------------------
# WorkPulse environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The cluster hosts unrelated databases; WorkPulse touches ONLY the two below.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_DB=workpulse
MONGODB_TEST_DB=workpulse_test

# --- API -------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# --- Secrets ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
ADMIN_ACCESS_TTL=15m
ADMIN_REFRESH_TTL=7d
AGENT_ACCESS_TTL=15m
AGENT_REFRESH_TTL=30d

# --- Presence / status engine ---------------------------------------------
# Seconds without a heartbeat before a device is considered offline.
PRESENCE_OFFLINE_AFTER_SEC=90
# How often the sweeper checks for stale devices.
PRESENCE_SWEEP_INTERVAL_SEC=15

# --- Background workers ----------------------------------------------------
ROLLUP_INTERVAL_SEC=60
RETENTION_INTERVAL_SEC=3600

# --- Seed (development only) ----------------------------------------------
SEED_ORG_NAME=Acme Corporation
SEED_ADMIN_EMAIL=admin@acme.test
SEED_ADMIN_PASSWORD=Admin123!pass

# --- Admin dashboard (Vite) ------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
